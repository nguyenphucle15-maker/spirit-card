---
// Biểu đồ đa giác 6 đỉnh cố định, điểm 0–5. Vẽ sẵn bằng SVG, không cần JavaScript.
import { FLAVOR_AXES } from "../lib/notion.js";
const { profile, labels } = Astro.props;
const C = 150, R = 100, MAX = 5;
const pt = (i, v) => {
  const a = (i / FLAVOR_AXES.length) * Math.PI * 2 - Math.PI / 2;
  return [C + R * (v / MAX) * Math.cos(a), C + R * (v / MAX) * Math.sin(a)];
};
const ring = (v) => FLAVOR_AXES.map((_, i) => pt(i, v).join(",")).join(" ");
const shape = FLAVOR_AXES.map((k, i) => pt(i, profile[k]).join(",")).join(" ");
const labelPos = FLAVOR_AXES.map((_, i) => pt(i, MAX + 1.25));
---
<figure class="radar">
  <svg viewBox="0 0 300 300" role="img"
    aria-label={FLAVOR_AXES.map((k) => `${labels[k]} ${profile[k]}/5`).join(", ")}>
    {[1, 2, 3, 4, 5].map((v) => (
      <polygon points={ring(v)} fill="none" stroke="var(--line)" stroke-width={v === 5 ? 1.5 : 1} />
    ))}
    {FLAVOR_AXES.map((_, i) => {
      const [x, y] = pt(i, MAX);
      return <line x1={C} y1={C} x2={x} y2={y} stroke="var(--line)" />;
    })}
    <polygon points={shape} fill="rgba(138,59,18,.22)" stroke="var(--accent)" stroke-width="2" />
    {FLAVOR_AXES.map((k, i) => {
      const [x, y] = pt(i, profile[k]);
      return <circle cx={x} cy={y} r="3.5" fill="var(--accent)" />;
    })}
    {FLAVOR_AXES.map((k, i) => (
      <text x={labelPos[i][0]} y={labelPos[i][1]} text-anchor="middle" dominant-baseline="middle"
        font-size="11" fill="var(--ink-2)">
        {labels[k]} · {profile[k]}
      </text>
    ))}
  </svg>
</figure>

<style>
  .radar { margin: 0; max-width: 340px; }
  .radar svg { width: 100%; height: auto; overflow: visible; }
</style>
